//: # Lesson 5: `@MainActor` — More Than "Run on Main Thread"
//:
//: **The nuance:** `@MainActor` is a *global actor* — a compiler-enforced isolation domain,
//: not just a DispatchQueue.main wrapper. Its implications are subtle:
//: - Functions annotated with `@MainActor` always run on the main thread
//: - Calling them from a non-isolated context causes an implicit hop
//: - `nonisolated` async functions do NOT inherit the caller's actor context
//: - Mixing old `DispatchQueue.main.sync` with Swift Concurrency causes deadlocks
//:
//: **Real scenario:** A ViewModel fetching data on a background thread,
//: then updating published properties. Where exactly does the hop happen?

import Foundation
import PlaygroundSupport
PlaygroundPage.current.needsIndefiniteExecution = true

// MARK: - Helper for educational/debugging purposes

// Note: Thread.isMainThread is unavailable in async contexts because Swift concurrency
// focuses on *actor isolation* rather than specific threads. However, for demonstration
// purposes, we can access it through an unsafe escape hatch.
nonisolated(unsafe) func isRunningOnMainThread() -> Bool {
    Thread.isMainThread
}

// MARK: - A typical ViewModel

@MainActor
class FeedViewModel {
    var posts: [String] = []
    var isLoading = false

    func loadFeed() async {
        isLoading = true
        print("loadFeed() — main thread: \(isRunningOnMainThread())")  // true, @MainActor

        // nonisolated async function — runs on cooperative thread pool, NOT main thread
        let fetched = await FeedService.fetchPosts()

        // After the await, we're back on @MainActor — the runtime hops us back
        self.posts = fetched
        self.isLoading = false
        print("Back in loadFeed() after await — main thread: \(isRunningOnMainThread())") // true again
    }
}

// MARK: - A service with no actor annotation — runs on cooperative pool

class FeedService {
    // `nonisolated` is implicit here — no @MainActor, not inside an actor
    static func fetchPosts() async -> [String] {
        print("fetchPosts() — main thread: \(Thread.isMainThread)") // false
        try? await Task.sleep(for: .milliseconds(200))
        return ["Post A", "Post B", "Post C"]
    }
}

// MARK: - actor with MainActor.run for one-off hops

actor DataPipeline {
    func process() async -> String {
        print("process() — main thread: \(Thread.isMainThread)") // false, inside actor

        let data = await heavyWork()

        // Need to update UI state from inside a non-MainActor context
        // Option 1: MainActor.run { } for a one-off hop
        await MainActor.run {
            print("MainActor.run block — main thread: \(Thread.isMainThread)") // true
        }

        return data
    }

    private func heavyWork() async -> String {
        try? await Task.sleep(for: .milliseconds(100))
        return "processed data"
    }
}

// MARK: - The deadlock trap (explained, not run — it would hang the playground)

//  ❌ NEVER do this from any async context that runs on the main thread:
//
//  @MainActor func updateUI() {
//      DispatchQueue.main.sync {   // ← deadlock: main thread waits for main thread
//          label.text = "done"
//      }
//  }
//
//  ✅ Instead, just assign directly (you're already on MainActor)
//  or use `await MainActor.run { }` from a non-MainActor context.

// MARK: - Demo

Task { @MainActor in
    print("=== ViewModel load ===\n")
    let vm = FeedViewModel()
    await vm.loadFeed()
    print("Posts: \(vm.posts)\n")

    print("=== DataPipeline hop ===\n")
    let pipeline = DataPipeline()
    let result = await pipeline.process()
    print("Result: \(result)\n")

    print("Key insight: @MainActor is a compiler contract, not just a queue dispatch.")
    print("The runtime handles the thread hop automatically at every `await` boundary.")

    PlaygroundPage.current.finishExecution()
}
